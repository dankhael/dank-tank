# dank-tank configuration — copy to ~/.config/dank-tank/config.env
#
# Sourced by claude-usage and dank-tank-notify. Plain shell assignments.

# Percentages at which to warn, per window. Each fires at most once per window.
# Set to "" to silence a category entirely.
SESSION_THRESHOLDS="50 80 95"
WEEKLY_THRESHOLDS="50 80 95"
SPEND_THRESHOLDS="50 80 95"

# Codex, Antigravity and OpenCode inherit SESSION/WEEKLY_THRESHOLDS when
# omitted (OpenCode's monthly window inherits its weekly one). Define these
# only when a provider should alert at different percentages.
CODEX_SESSION_THRESHOLDS="50 80 95"
CODEX_WEEKLY_THRESHOLDS="50 80 95"
ANTIGRAVITY_SESSION_THRESHOLDS="50 80 95"
ANTIGRAVITY_WEEKLY_THRESHOLDS="50 80 95"
OPENCODE_SESSION_THRESHOLDS="50 80 95"
OPENCODE_WEEKLY_THRESHOLDS="50 80 95"
OPENCODE_MONTHLY_THRESHOLDS="50 80 95"

# Say something when a window you had nearly exhausted rolls over.
NOTIFY_ON_RESET=1
RESET_NOTICE_ABOVE=80

# Seconds before a cached reading is considered stale. The statusline reads the
# cache rather than the network, so this is effectively how fresh it looks.
CLAUDE_USAGE_MAX_AGE=60

# Name shown as the notification source.
APP_NAME="dank-tank"
