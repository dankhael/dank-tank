#!/usr/bin/env bash
# opencode-usage — OpenCode Go plan limits (5-hour, weekly, monthly).
#
# Asks GET https://opencode.ai/zen/go/v1/usage with the Go API key OpenCode
# already stores. The endpoint is not documented; if it changes, this degrades
# to "no data" rather than misreporting. The key is read, never written, and is
# handed to curl on stdin so it does not show up in the process list.

set -uo pipefail

ENDPOINT="${OPENCODE_USAGE_URL:-https://opencode.ai/zen/go/v1/usage}"
DB="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"
AUTH_JSON="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-usage"
CACHE="$CACHE_DIR/usage.json"
STALE="$CACHE_DIR/stale"
MAX_AGE="${OPENCODE_USAGE_MAX_AGE:-60}"

usage() {
  cat <<'EOF'
opencode-usage — OpenCode Go plan limit tracker

  opencode-usage              compact report
  opencode-usage --json       raw usage payload
  opencode-usage --bar-json   precomputed fields for a bar widget
  opencode-usage --refresh    force a fresh query
  opencode-usage --max-age N  cache age in seconds (default 60)

Key: $OPENCODE_GO_API_KEY, else the active "opencode-go" credential in
OpenCode's database, else auth.json.

Exit codes: 0 ok · 2 no key · 3 key rejected · 4 query failed
EOF
}

api_key() {
  if [[ -n "${OPENCODE_GO_API_KEY:-}" ]]; then
    printf '%s' "$OPENCODE_GO_API_KEY"; return 0
  fi
  local key=''
  if [[ -r "$DB" ]] && command -v sqlite3 >/dev/null; then
    key=$(sqlite3 -readonly "$DB" "
      select json_extract(value, '\$.key') from credential
      where integration_id = 'opencode-go' and active = 1
      order by time_updated desc limit 1" 2>/dev/null)
  fi
  if [[ -z "$key" && -r "$AUTH_JSON" ]]; then
    key=$(jq -r '.["opencode-go"].key // empty' "$AUTH_JSON" 2>/dev/null)
  fi
  [[ -n "$key" ]] || return 1
  printf '%s' "$key"
}

fetch() {
  local key tmp code
  key=$(api_key) || return 2
  mkdir -p "$CACHE_DIR"
  tmp=$(mktemp "$CACHE_DIR/.fetch.XXXXXX")
  code=$(printf 'Authorization: Bearer %s\n' "$key" |
    curl -sS -m 15 -o "$tmp" -w '%{http_code}' -H @- "$ENDPOINT" 2>/dev/null) || code=000
  case "$code" in
    200)
      if jq -e '.usage | type == "object"' "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$CACHE"; rm -f "$STALE"; return 0
      fi ;;
    401|403) rm -f "$tmp"; return 3 ;;
  esac
  rm -f "$tmp"
  return 4
}

ensure_cache() {
  local force=${1:-0} age=99999 rc
  [[ -f "$CACHE" ]] && age=$(( $(date +%s) - $(stat -c %Y "$CACHE") ))
  if [[ "$force" == 1 || "$age" -ge "$MAX_AGE" ]]; then
    fetch; rc=$?
    (( rc == 0 )) && return 0
    [[ -f "$CACHE" ]] && { touch "$STALE"; return 0; }
    return "$rc"
  fi
  return 0
}

humanize() {
  local s=$1
  (( s < 0 )) && s=0
  if   (( s >= 86400 )); then printf '%dd%dh' $(( s/86400 )) $(( (s%86400)/3600 ))
  elif (( s >= 3600  )); then printf '%dh%dm' $(( s/3600 ))  $(( (s%3600)/60 ))
  else                        printf '%dm'    $(( s/60 ))
  fi
}

pace() { # pace USED WINDOW_SECONDS RESETS_AT
  local used=$1 len=$2 reset=$3 left elapsed delta
  (( len > 0 && reset > 0 )) || { printf '?'; return; }
  left=$(( reset - $(date +%s) ))
  elapsed=$(( (len - left) * 100 / len ))
  (( elapsed < 0 )) && elapsed=0; (( elapsed > 100 )) && elapsed=100
  delta=$(( used - elapsed ))
  if   (( delta >  10 )); then printf '↑'
  elif (( delta < -10 )); then printf '↓'
  else                         printf '→'
  fi
}

bar_json() {
  local stale=false now windows='[]' key name pct status reset epoch len left item
  [[ -f "$STALE" ]] && stale=true
  now=$(date +%s)

  for key in rolling weekly monthly; do
    IFS=$'\t' read -r pct status reset < <(jq -r --arg k "$key" '
      .usage[$k] // empty | [((.percent // 0) | floor), (.status // ""), (.resetsAt // "")] | @tsv
    ' "$CACHE") || continue
    [[ -n "$pct" ]] || continue
    epoch=$(date -d "$reset" +%s 2>/dev/null || echo 0)
    case "$key" in
      rolling) name=5h;  len=18000 ;;
      weekly)  name=7d;  len=604800 ;;
      monthly) name=1mo  # calendar month ending at the reset
               len=$(( epoch - $(date -d "$reset -1 month" +%s 2>/dev/null || echo "$epoch") )) ;;
    esac
    left=$(( epoch - now )); (( left < 0 )) && left=0
    item=$(jq -n --arg name "$name" --argjson pct "$pct" --arg status "$status" \
      --arg left "$(humanize "$left")" --arg pace "$(pace "$pct" "$len" "$epoch")" \
      --argjson minutes $(( len / 60 )) --argjson resets_at "$epoch" \
      '{name:$name,pct:$pct,status:$status,left:$left,pace:$pace,minutes:$minutes,resets_at:$resets_at}')
    windows=$(jq -c --argjson item "$item" '. + [$item]' <<<"$windows")
  done

  jq -n --argjson windows "$windows" --argjson stale "$stale" \
    '{provider:"opencode",plan:"Go",windows:$windows,stale:$stale}'
}

MODE=report
FORCE=0
while (( $# )); do
  case "$1" in
    --json)     MODE=json ;;
    --bar-json) MODE=bar ;;
    --refresh)  FORCE=1 ;;
    --max-age)  [[ $# -ge 2 ]] || { usage >&2; exit 64; }; MAX_AGE=$2; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          printf 'unknown option: %s\n' "$1" >&2; usage >&2; exit 64 ;;
  esac
  shift
done

ensure_cache "$FORCE"; rc=$?
if (( rc != 0 )); then
  case "$rc" in
    2) echo 'opencode-usage: no OpenCode Go key found (opencode auth login)' >&2 ;;
    3) echo 'opencode-usage: OpenCode Go key was rejected' >&2 ;;
    *) echo 'opencode-usage: could not query OpenCode Go usage' >&2 ;;
  esac
  exit "$rc"
fi

case "$MODE" in
  json) cat "$CACHE" ;;
  bar)  bar_json ;;
  *)
    data=$(bar_json) || exit $?
    printf 'OpenCode Go usage%s\n' "$([[ $(jq -r .stale <<<"$data") == true ]] && printf ' (stale)')"
    jq -r '.windows[] | "  \(.name)  \(.pct)% \(.pace)  resets in \(.left)" +
      (if .status != "ok" and .status != "" then "  [\(.status)]" else "" end)' <<<"$data"
    ;;
esac
